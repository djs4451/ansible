{
  "title": "Linux Hosts",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 - (avg by(instance)(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Filesystem Available",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes"
        }
      ]
    },
    {
      "id": 4,
      "title": "Load Average",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_load1"
        }
      ]
    }
  ]
}
